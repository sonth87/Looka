{
  "name": "@face/desktop",
  "version": "0.1.0",
  "description": "Looka - Offline-first Face Capture Desktop App",
  "author": "Skyline <sonth87@gmail.com>",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "vite build --emptyOutDir false && tsc -p tsconfig.electron.json",
    "package": "pnpm prepackage && electron-builder",
    "package:mac": "pnpm prepackage && electron-builder --mac",
    "package:win": "pnpm prepackage && electron-builder --win",
    "test": "tsc -p tsconfig.electron.json && node --test dist/main/__tests__/*.test.js",
    "prepackage": "rimraf dist release && pnpm fetch:assets && pnpm build",
    "package:win:dir": "pnpm prepackage && electron-builder --win --dir",
    "fetch:assets": "node ./scripts/fetch-assets.mjs",
    "start": "electron .",
    "start:build": "pnpm build && electron ."
  },
  "dependencies": {
    "@face/attendance-engine": "workspace:*",
    "@face/biometric": "workspace:*",
    "@face/camera": "workspace:*",
    "@face/core": "workspace:*",
    "@face/cv-engine": "workspace:*",
    "@face/cv-mediapipe": "workspace:*",
    "@face/database": "workspace:*",
    "@face/face-quality": "workspace:*",
    "@face/fs-client": "workspace:*",
    "@face/hand-gesture": "workspace:*",
    "@face/recognition-engine": "workspace:*",
    "@face/ui": "workspace:*",
    "@face/workflow-engine": "workspace:*",
    "@iconify/react": "catalog:",
    "@sonth87/device-layout": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}