# SSO login layer for the CMS admin app — see docs/LOGIN.md and
# src/auth/env.ts. Copy this file to .env and fill in real values for an
# environment that actually has SSO; leave both empty/unset for local dev —
# src/auth/env.ts then logs a console warning and the CMS renders with no
# login gate at all (no SSO redirect, no /auth/* calls; there is no api-key
# fallback any more, so apps/api's CMS/admin routes will 401 unless its own
# dev bypass, ALLOW_UNAUTHENTICATED_ADMIN_DEV, is also set).

# URL of the external SSO login page. Used to build the redirect
# `${VITE_URL_LOGIN_SSO}?continueUrl=...` (docs/LOGIN.md §3.2/§8).
# Example value below is the same test SSO host docs/LOGIN.md itself uses.
VITE_URL_LOGIN_SSO=https://test-login.dainam.edu.vn/

# baseURL for the SSO backend's /auth/* endpoints (profile, logout,
# refresh-token). Falls back to VITE_URL_LOGIN_SSO when unset (docs/LOGIN.md
# §8) — most environments run the login page and its API on the same origin,
# so this is usually only needed when they differ.
VITE_BE_URL_WORKSPACE=
