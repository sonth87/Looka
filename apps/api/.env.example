# Postgres the API owns. Nothing else writes to this database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/looka

# file-service. The key is namespace-wide, so it stays on this side and never
# reaches a browser — see section 2 of the integration guide.
FS_BASE_URL=http://192.168.101.32:8080
FS_TENANT=looka-face-capture
# Leave FS_API_KEY empty to obtain one at startup via self-service provisioning,
# which is keyed by tenant name and returns the same key every time.
FS_API_KEY=
# Contact email recorded on the tenant when FS_API_KEY is empty and this
# service provisions one itself. Only read at provisioning time.
FS_CONTACT_EMAIL=camera@dainam.edu.vn

PORT=3100
NODE_ENV=development
# DB_POOL_MAX=10

# Shared secret the capture pipeline's own caller (apps/web's unattended
# kiosk browser) sends in the x-api-key header - required only for the
# genuine capture writes: POST /v1/sessions, POST /v1/sessions/:id/photos,
# GET /v1/sessions/:id/photos, POST /v1/sessions/:id/complete. The CMS/admin
# surface (campaigns, devices, the CMS-facing GET /v1/sessions[/:id] routes,
# and POST /v1/photos/:id/view-link) moved off this key to SsoAuthGuard - see
# SSO_BASE_URL below. Required regardless - ApiKeyMiddleware refuses to start
# the app without it.
API_KEY=

# External SSO backend base URL, used by SsoAuthGuard to verify the CMS/admin
# surface's bearer token via `GET <SSO_BASE_URL>/auth/profile` — see
# docs/LOGIN.md §12. Left blank here on purpose (no real SSO URL committed);
# SsoAuthGuard fails closed (rejects every request) while this is unset,
# unless the dev-only ALLOW_UNAUTHENTICATED_ADMIN_DEV=true bypass is also set
# (never set that in a deployed environment).
SSO_BASE_URL=

# Paths to the built Electron installers, embedded as-is into a device
# activation zip depending on which OS the admin picked when registering
# (see docs/plans/multi-camera-device-management-discussion.md §3.2). Left
# empty in dev - the zip then contains activation.json alone.
DESKTOP_INSTALLER_PATH_MAC=
DESKTOP_INSTALLER_PATH_WIN=

# The external "AI photo edit" service (2026-09-28) — a locally-hosted
# generative image-edit model, per its own integration guide ("Hướng dẫn
# tích hợp API Chỉnh sửa ảnh sử dụng Model local"). AiImageEditClient falls
# back to the guide's own documented address when unset. Timeout must stay
# >= the service's own REQUEST_TIMEOUT_S (120s default, 600s if it runs with
# LOW_VRAM=1) — real observed latency during live verification (steps=15 on
# a real portrait: 278s server-side, ~342s wall time) already exceeds 120s,
# so this defaults to 600000 (the LOW_VRAM=1 ceiling) here, not 150000.
AI_IMAGE_EDIT_URL=http://10.20.15.25:8000
AI_IMAGE_EDIT_TIMEOUT_MS=600000

# The external "Attendance — Face Enrollment API" face-embedding server
# (2026-09-16 — EmbeddingWorkerService, apps/api/src/modules/capture/services/
# embedding-worker.service.ts). Photos are enqueued into `embedding_jobs` the
# instant they are saved (PhotoService.addPhoto/addDevicePhoto) and this
# worker drains that queue asynchronously — the desktop kiosk no longer calls
# this server itself. Left blank here; EmbeddingWorkerService falls back to
# the same real, network-reachable default the old desktop client used.
EMBEDDING_SERVER_BASE_URL=http://10.20.107.17:8000

# The university's own open API for student directory data
# (DainamStudentInfoClient, POST /api/get_list_student_info) — not wired to
# any caller yet. Real, namespace-wide credential — never commit a real
# value here. Left blank in dev; DainamStudentInfoClient refuses to call out
# while this is unset.
DAINAM_STUDENT_INFO_BASE_URL=https://openapi.dainam.edu.vn
DAINAM_STUDENT_INFO_API_KEY=

# At-rest encryption key for `sessions.citizen_id_enc` (CCCD) —
# shared/security/citizen-id.codec.ts, cms-8-screens-api-plan.md §8 I-Q1.
# 32 raw bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Left blank in dev — encrypting/decrypting a citizen id throws a clear
# error until this is set; nothing else in the app requires it to boot.
CITIZEN_ID_ENCRYPTION_KEY=

# At-rest encryption key for `eligibility_api_clients.credential_ciphertext`
# (a workflow's own "điều kiện tiếp nhận" API key/token, entered from the
# CMS) — shared/security/secret.codec.ts, plan item 7, 2026-09-17. Separate
# key from CITIZEN_ID_ENCRYPTION_KEY above (different secret domain, so
# rotating one never touches the other). 32 raw bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Left blank in dev — encrypting/decrypting a credential throws a clear
# error until this is set; nothing else in the app requires it to boot.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=

# External admin directory (`UserDirectoryClient`, POST /v1/users/sync) —
# spec not yet provided (cms-8-screens-api-plan.md §2.8 D-Q10). Left blank;
# the sync endpoint returns a clear "not configured" outcome until set.
USER_DIRECTORY_URL=
USER_DIRECTORY_API_KEY=
