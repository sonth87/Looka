{
  "name": "@face/fs-client",
  "version": "0.1.0",
  "description": "Client for the file-service: resumable chunked upload, idempotent retries, scan-status polling",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
